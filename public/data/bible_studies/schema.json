{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milsimrooster.com/data/bible_studies/schema.json",
  "title": "Milsim Rooster Adult Bible Study",
  "description": "Reference-backed adult Bible study content that keeps textual observation, teaching, interpretive caution, application, discussion, and prayer distinct.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "title",
    "summary",
    "primary_references",
    "observations",
    "teaching",
    "interpretive_cautions",
    "application",
    "discussion",
    "prayer",
    "pastoral_safety",
    "tags",
    "estimated_minutes",
    "review"
  ],
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter", "verse"],
      "properties": {
        "chapter": { "type": "integer", "minimum": 1 },
        "verse": { "type": "integer", "minimum": 1 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "book", "book_slug", "start", "end", "role"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "book": { "type": "string", "minLength": 1 },
        "book_slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "start": { "$ref": "#/$defs/endpoint" },
        "end": { "$ref": "#/$defs/endpoint" },
        "role": { "type": "string", "enum": ["primary", "supporting"] }
      }
    },
    "supported_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "supporting_references"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "supporting_references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "caution": {
      "allOf": [
        { "$ref": "#/$defs/supported_statement" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["genre", "scope", "legitimate-dispute", "pastoral-safety", "textual-note"]
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference_review", "doctrinal_review", "reviewed_at", "content_version"],
      "properties": {
        "status": { "const": "public-ready" },
        "reference_review": { "const": "automated-passed" },
        "doctrinal_review": { "const": "independent-editorial" },
        "reviewed_at": { "const": "2026-08-12" },
        "content_version": { "const": "1.0.0" }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "adult-bible-study/v1" },
    "study_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "primary_references": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
    "observations": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/supported_statement" } },
    "teaching": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/supported_statement" } },
    "interpretive_cautions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/caution" } },
    "application": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "discussion": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "prayer": { "type": "string", "minLength": 1 },
    "pastoral_safety": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "estimated_minutes": { "type": "integer", "minimum": 10, "maximum": 90 },
    "review": { "$ref": "#/$defs/review" }
  }
}
